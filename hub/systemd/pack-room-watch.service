[Unit]
Description=Pack room watcher (@mention -> task card)
After=network.target pack-hub.service

[Service]
Type=simple
User=hatch
Group=hatch
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
WorkingDirectory=/home/hatch/workspace/pack/hub
ExecStart=/home/hatch/workspace/pack/hub/.venv/bin/python /home/hatch/workspace/pack/hub/room_watch.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
