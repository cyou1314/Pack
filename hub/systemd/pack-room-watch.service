[Unit]
Description=Pack Room Watch
After=pack-hub.service network-online.target
Requires=pack-hub.service
Wants=network-online.target

[Service]
Type=simple
User=@PACK_USER@
WorkingDirectory=@PACK_ROOT@/hub
ExecStart=@PACK_ROOT@/hub/.venv/bin/python @PACK_ROOT@/hub/room_watch.py
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
