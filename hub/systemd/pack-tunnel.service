[Unit]
Description=Pack hub tunnel (pinggy ssh, free tier: URL rotates on reconnect)
After=network.target pack-hub.service

[Service]
Type=simple
Environment=HOME=/home/hatch
ExecStart=/usr/bin/ssh -p 443 -R0:localhost:8794 -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -o BatchMode=yes -T a.pinggy.io
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
