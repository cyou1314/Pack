<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.pack.local-hub</string>
<key>ProgramArguments</key><array><string>__PYTHON__</string><string>__HUB__/hub.py</string><string>serve</string></array>
<key>WorkingDirectory</key><string>__HUB__</string>
